# =============================================
# .gitignore for TSATMS — Amdocs Capstone
# =============================================

# ---- Maven Build Output (NEVER commit these) ----
target/
*.class
*.jar
*.war
*.ear

# ---- Runtime Generated Reports ----
reports/
!reports/.gitkeep

# ---- IDE Files — IntelliJ IDEA ----
.idea/
*.iml
*.iws
*.ipr
out/

# ---- IDE Files — Eclipse ----
.classpath
.project
.settings/
bin/

# ---- IDE Files — VS Code ----
.vscode/

# ---- OS Clutter ----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---- Logs ----
*.log
logs/

# ---- Sensitive Config (credentials) ----
src/main/resources/config.properties
src/main/resources/db.properties
*.env

# ---- Package/Archive Files ----
*.zip
*.tar.gz
*.rar
